#!/usr/bin/env bash
#
# pre-commit hook: Flyway 적용 완료 마이그레이션 파일 변경 차단
#
# 호출:    check-flyway-immutability.sh --staged
# 종료 코드:
#   0  통과 (commit 진행)
#   1  immutability 위반 발견 (commit 차단)
#   2  스크립트 사용 오류 (commit 차단)
#
# 설치:
#   bash scripts/install-git-hooks.sh
#
# 우회 (디버깅 목적에만 사용, 실제 위반 회피용 사용 금지 — CI에서 다시 차단됨):
#   git commit --no-verify
#

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
exec bash "$REPO_ROOT/scripts/check-flyway-immutability.sh" --staged
